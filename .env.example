# Copiá este archivo a .env.local y completá con los datos de tu proyecto
# de Supabase (Project Settings > API). .env.local no se sube a git.
# En Cloudflare Pages, estas mismas variables se cargan en
# Settings > Environment variables (no hace falta el archivo ahí).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX

# Dominio de la plataforma para subdominios tipo <slug>.plataformagym.com.ar
# (opcional, se usa como fallback cuando el gimnasio no tiene dominio propio).
VITE_PLATFORM_DOMAIN=plataformagym.com.ar

# Solo en desarrollo local: qué gimnasio cargar cuando no hay dominio real.
VITE_DEV_GYM_SLUG=forge
